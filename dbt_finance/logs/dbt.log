    create or replace table `elt-commodities-backtesting`.`mart`.`mart_backtest_trades`
      
    partition by trade_date
    cluster by symbol, strategy_name

    OPTIONS()
    as (
      

with positioned as (
    select
        *,
        lag(executed_position, 1, 0) over (
            partition by strategy_name, symbol
            order by date
        ) as previous_position
    from `elt-commodities-backtesting`.`mart`.`mart_backtest_daily`
)

select
    commodity_id,
    commodity_name,
    symbol,
    strategy_name,
    date as trade_date,
    close as trade_price,
    previous_position,
    executed_position,
    executed_position - previous_position as position_delta,
    abs(executed_position - previous_position)
    * (
        0.001
        + 0.0005
    ) as estimated_transaction_cost_rate,
    abs(executed_position - previous_position)
    * 0.001 as estimated_fee,
    abs(executed_position - previous_position)
    * 0.0005 as estimated_slippage,
    case
        when previous_position = 0 and executed_position != 0 then 'open'
        when previous_position != 0 and executed_position = 0 then 'close'
        when previous_position != executed_position then 'rebalance'
    end as trade_type
from positioned
where previous_position != executed_position
    );
  
