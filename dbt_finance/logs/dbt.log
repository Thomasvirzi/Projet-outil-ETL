    create or replace table `elt-commodities-backtesting`.`dbt_finance`.`int_tradable_assets`
      
    partition by date
    cluster by symbol, category

    OPTIONS()
    as (
      

with commodity_prices as (
    select
        commodity_id,
        commodity_name,
        symbol,
        category,
        date,
        open,
        high,
        low,
        close,
        adjusted_close,
        volume_filled as volume
    from `elt-commodities-backtesting`.`dbt_finance`.`stg_commodity_prices`
),

synthetic_index as (
    select
        'COMMODITY_INDEX' as commodity_id,
        benchmark_name as commodity_name,
        'COMMODITY_INDEX' as symbol,
        'benchmark' as category,
        date,
        benchmark_level as open,
        benchmark_level as high,
        benchmark_level as low,
        benchmark_level as close,
        benchmark_level as adjusted_close,
        cast(null as float64) as volume
    from `elt-commodities-backtesting`.`dbt_finance`.`stg_benchmarks`
    where benchmark_id = 'synthetic_commodity_index'
      and component_id is null
      and benchmark_level is not null
)

select * from commodity_prices

union all

select * from synthetic_index
    );
  
