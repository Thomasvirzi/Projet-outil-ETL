    create or replace table `elt-commodities-backtesting`.`dbt_finance`.`int_daily_returns`
      
    partition by date
    cluster by symbol, strategy_name

    
    OPTIONS()
    as (
      

select
    commodity_id,
    commodity_name,
    symbol,
    category,
    strategy_name,
    date,
    close,
    simple_return as asset_return,
    signal,
    lag(signal, 1, 0) over (
