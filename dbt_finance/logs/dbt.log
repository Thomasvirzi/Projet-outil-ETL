                            and upper(table_name) = upper('landing_pipeline_logs')
                            ) or (
                                upper(table_schema) = upper('dbt_finance')
                            and upper(table_name) = upper('stg_commodity_prices')
                            ) or (
                                upper(table_schema) = upper('dbt_finance')
                            and upper(table_name) = upper('int_commodity_news_features')
                            ) or (
                                upper(table_schema) = upper('dbt_finance')
                            and upper(table_name) = upper('int_tradable_assets')
                            ) or (
                                upper(table_schema) = upper('dbt_finance')
                            and upper(table_name) = upper('landing_benchmarks')
                            ) or (
                                upper(table_schema) = upper('dbt_finance')
                            and upper(table_name) = upper('stg_benchmarks')
                            ) or (
                                upper(table_schema) = upper('dbt_finance')
                            and upper(table_name) = upper('landing_article_commodity_relevance')
                            ) or (
                                upper(table_schema) = upper('dbt_finance')
                            and upper(table_name) = upper('landing_news_sentiment')
                            ) or (
                                upper(table_schema) = upper('dbt_finance')
                            and upper(table_name) = upper('int_technical_indicators')
                            ) or (
                                upper(table_schema) = upper('dbt_finance')
                            and upper(table_name) = upper('int_article_commodity_relevance')
                            ) or (
                                upper(table_schema) = upper('dbt_finance')
                            and upper(table_name) = upper('landing_news_features')
                            ) or (
                                upper(table_schema) = upper('dbt_finance')
                            and upper(table_name) = upper('stg_news_sentiment')
                            ) or (
                                upper(table_schema) = upper('dbt_finance')
                            and upper(table_name) = upper('stg_news')
                            ) or (
                                upper(table_schema) = upper('dbt_finance')
                            and upper(table_name) = upper('landing_market_data')
                            ) or (
