    create or replace table `elt-commodities-backtesting`.`mart`.`mart_strategy_metrics`
      
    partition by start_date
    cluster by symbol, strategy_name

    OPTIONS()
    as (
      

with daily as (
    select * from `elt-commodities-backtesting`.`mart`.`mart_backtest_daily`
),

equity_curve as (
    select
        *,
        1 + cumulative_strategy_return as strategy_equity_index,
        max(1 + cumulative_strategy_return) over (
            partition by strategy_name, symbol
